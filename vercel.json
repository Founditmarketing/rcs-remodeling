{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.php/:path*",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/feed",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/feed/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/wp-json/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/comments/:path*",
      "destination": "/",
      "statusCode": 301
    }
  ]
}